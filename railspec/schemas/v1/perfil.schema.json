{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Quién hizo algo, por qué canal. Va en todo lo que se escribe.\n\nLa identidad estable es el id numérico de GitHub (el login puede cambiar).\nEl proveedor de identidad queda detrás de ``proveedor_identidad`` para que\notro (Azure DevOps, Entra ID) entre como valor nuevo sin romper el esquema.",
      "properties": {
        "agente": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nodo o rol del agente, si tipo=agente.",
          "title": "Agente"
        },
        "canal": {
          "$ref": "#/$defs/Canal"
        },
        "en_nombre_de": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "github_id del humano por quien actúa un agente.",
          "title": "En Nombre De"
        },
        "github_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Id"
        },
        "login": {
          "anyOf": [
            {
              "description": "Login de GitHub; informativo, la identidad es github_id.",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login"
        },
        "oidc": {
          "anyOf": [
            {
              "$ref": "#/$defs/OidcGithubActions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proveedor_identidad": {
          "default": "github",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "title": "Proveedor Identidad",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoActor"
        }
      },
      "required": [
        "tipo",
        "canal"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Auditoria": {
      "additionalProperties": false,
      "properties": {
        "actualizado_en": {
          "format": "date-time",
          "title": "Actualizado En",
          "type": "string"
        },
        "actualizado_por": {
          "$ref": "#/$defs/Actor"
        },
        "creado_en": {
          "format": "date-time",
          "title": "Creado En",
          "type": "string"
        },
        "creado_por": {
          "$ref": "#/$defs/Actor"
        }
      },
      "required": [
        "creado_por",
        "creado_en",
        "actualizado_por",
        "actualizado_en"
      ],
      "title": "Auditoria",
      "type": "object"
    },
    "Canal": {
      "enum": [
        "arnes",
        "consola",
        "ci",
        "servidor"
      ],
      "title": "Canal",
      "type": "string"
    },
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "Effort",
      "type": "string"
    },
    "OidcGithubActions": {
      "additionalProperties": false,
      "description": "Identidad de servicio emitida por el token OIDC de GitHub Actions.",
      "properties": {
        "repositorio": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repositorio",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "workflow": {
          "description": "Claim workflow_ref.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "repositorio",
        "workflow"
      ],
      "title": "OidcGithubActions",
      "type": "object"
    },
    "Perfil": {
      "enum": [
        "ligero",
        "estandar",
        "profundo"
      ],
      "title": "Perfil",
      "type": "string"
    },
    "Proveedor": {
      "enum": [
        "foundry",
        "anthropic"
      ],
      "title": "Proveedor",
      "type": "string"
    },
    "RequisitoRol": {
      "additionalProperties": false,
      "properties": {
        "contexto_min_tokens": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Contexto Min Tokens"
        },
        "effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "modelo": {
          "additionalProperties": {
            "type": "string"
          },
          "description": "Modelo por proveedor.",
          "minProperties": 1,
          "propertyNames": {
            "$ref": "#/$defs/Proveedor"
          },
          "title": "Modelo",
          "type": "object"
        },
        "structured_outputs": {
          "default": false,
          "title": "Structured Outputs",
          "type": "boolean"
        }
      },
      "required": [
        "modelo"
      ],
      "title": "RequisitoRol",
      "type": "object"
    },
    "Riesgo": {
      "enum": [
        "bajo",
        "medio",
        "alto"
      ],
      "title": "Riesgo",
      "type": "string"
    },
    "TipoActor": {
      "enum": [
        "humano",
        "servicio",
        "agente"
      ],
      "title": "TipoActor",
      "type": "string"
    },
    "TopeGate": {
      "additionalProperties": false,
      "properties": {
        "adversarial": {
          "title": "Adversarial",
          "type": "boolean"
        },
        "criticos": {
          "minimum": 1,
          "title": "Criticos",
          "type": "integer"
        },
        "iteraciones": {
          "minimum": 1,
          "title": "Iteraciones",
          "type": "integer"
        }
      },
      "required": [
        "criticos",
        "iteraciones",
        "adversarial"
      ],
      "title": "TopeGate",
      "type": "object"
    }
  },
  "$id": "https://railspec.dev/schemas/v1/perfil.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auditoria": {
      "$ref": "#/$defs/Auditoria"
    },
    "exploradores": {
      "additionalProperties": {
        "type": "integer"
      },
      "propertyNames": {
        "$ref": "#/$defs/Riesgo"
      },
      "title": "Exploradores",
      "type": "object"
    },
    "gate": {
      "additionalProperties": {
        "$ref": "#/$defs/TopeGate"
      },
      "propertyNames": {
        "$ref": "#/$defs/Riesgo"
      },
      "title": "Gate",
      "type": "object"
    },
    "nombre": {
      "$ref": "#/$defs/Perfil"
    },
    "org": {
      "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Org",
      "type": "string"
    },
    "roles": {
      "additionalProperties": {
        "$ref": "#/$defs/RequisitoRol"
      },
      "minProperties": 1,
      "title": "Roles",
      "type": "object"
    },
    "version": {
      "description": "Bloqueo optimista; +1 en cada escritura.",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "version_contrato": {
      "default": "1.3",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3"
      ],
      "title": "Version Contrato",
      "type": "string"
    },
    "workspace": {
      "anyOf": [
        {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Workspace"
    }
  },
  "required": [
    "version",
    "auditoria",
    "org",
    "nombre",
    "roles",
    "gate",
    "exploradores"
  ],
  "title": "PerfilConfig",
  "type": "object"
}
