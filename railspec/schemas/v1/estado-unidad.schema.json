{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Quién hizo algo, por qué canal. Va en todo lo que se escribe.\n\nLa identidad estable es el id numérico de GitHub (el login puede cambiar).\nEl proveedor de identidad queda detrás de ``proveedor_identidad`` para que\notro (Azure DevOps, Entra ID) entre como valor nuevo sin romper el esquema.",
      "properties": {
        "agente": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nodo o rol del agente, si tipo=agente.",
          "title": "Agente"
        },
        "canal": {
          "$ref": "#/$defs/Canal"
        },
        "en_nombre_de": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "github_id del humano por quien actúa un agente.",
          "title": "En Nombre De"
        },
        "github_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Id"
        },
        "login": {
          "anyOf": [
            {
              "description": "Login de GitHub; informativo, la identidad es github_id.",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login"
        },
        "oidc": {
          "anyOf": [
            {
              "$ref": "#/$defs/OidcGithubActions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proveedor_identidad": {
          "default": "github",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "title": "Proveedor Identidad",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoActor"
        }
      },
      "required": [
        "tipo",
        "canal"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AlcanceUnidad": {
      "additionalProperties": false,
      "description": "Espacio de nombres de una unidad.\n\nLa unidad cuelga del workspace, no de un repositorio, porque puede\nvincular N repositorios; cada snapshot dice a cuál pertenece. ``plan``\nagrupa unidades de un mismo mandato cuando lo hay.",
      "properties": {
        "org": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Org",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "unidad": {
          "description": "Identificador de unidad SDD con forma NNNN-slug.",
          "pattern": "^[0-9]{4}-[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Unidad",
          "type": "string"
        },
        "workspace": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "org",
        "workspace",
        "unidad"
      ],
      "title": "AlcanceUnidad",
      "type": "object"
    },
    "Arnes": {
      "enum": [
        "claude-code",
        "opencode",
        "codex",
        "copilot"
      ],
      "title": "Arnes",
      "type": "string"
    },
    "Canal": {
      "enum": [
        "arnes",
        "consola",
        "ci",
        "servidor"
      ],
      "title": "Canal",
      "type": "string"
    },
    "CausaEscalado": {
      "enum": [
        "hallazgos-sin-resolver",
        "sin-gobernanza",
        "presupuesto-agotado",
        "error-proveedor",
        "sin-convergencia",
        "importado"
      ],
      "title": "CausaEscalado",
      "type": "string"
    },
    "CausaParada": {
      "description": "Condiciones de parada tipificadas (kit SDD: ``.spec/PARADAS-SUPERVISADO.md``).\n\nLas cinco primeras detienen el mandato entero; las cuatro últimas, solo la unidad afectada\n(``gate-escalado`` es de ambas: en supervisado congela el mandato y en desatendido difiere la unidad).",
      "enum": [
        "gate-escalado",
        "plan-incompleto",
        "presupuesto-mandato",
        "mandato-caducado",
        "mandato-revocado",
        "unidad-amparada-fallida",
        "fuera-de-alcance",
        "decision-reservada",
        "reintentos-agotados"
      ],
      "title": "CausaParada",
      "type": "string"
    },
    "Checkpoint": {
      "additionalProperties": false,
      "description": "Decisión humana pendiente.\n\nSe resuelve por cualquier canal (elicitation en el arnés, ``unit.approve``\no la consola): gana la primera resolución que llegue y las siguientes se\nrechazan con ``checkpoint-ya-resuelto``.",
      "properties": {
        "abierto_en": {
          "format": "date-time",
          "title": "Abierto En",
          "type": "string"
        },
        "artefacto_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artefacto Sha256"
        },
        "causa_parada": {
          "anyOf": [
            {
              "$ref": "#/$defs/CausaParada"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Desde 1.11: por qué se detuvo una unidad bajo mandato (solo en `parada` y `gate-escalado`). None en una parada de una unidad sin mandato."
        },
        "fase": {
          "$ref": "#/$defs/Fase"
        },
        "id": {
          "format": "uuid4",
          "title": "Id",
          "type": "string"
        },
        "pregunta": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Pregunta",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoCheckpoint"
        }
      },
      "required": [
        "id",
        "tipo",
        "fase",
        "pregunta",
        "abierto_en"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "Cita": {
      "additionalProperties": false,
      "description": "Dónde está lo que el hallazgo señala.\n\nPara artefactos (spec, plan, tasks) basta ``seccion``; para código se\nexige ``ruta`` con rango de líneas.",
      "properties": {
        "linea_fin": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linea Fin"
        },
        "linea_inicio": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linea Inicio"
        },
        "ruta": {
          "anyOf": [
            {
              "description": "Ruta relativa a la raíz del repositorio, sin '..' ni '/' inicial.",
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ruta"
        },
        "seccion": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seccion"
        }
      },
      "title": "Cita",
      "type": "object"
    },
    "Consumo": {
      "additionalProperties": false,
      "properties": {
        "costo_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Costo Usd",
          "type": "number"
        },
        "llamadas": {
          "default": 0,
          "description": "Desde 1.7: llamadas al modelo que salieron al proveedor.",
          "minimum": 0,
          "title": "Llamadas",
          "type": "integer"
        },
        "segundos": {
          "default": 0,
          "minimum": 0,
          "title": "Segundos",
          "type": "integer"
        },
        "tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "title": "Consumo",
      "type": "object"
    },
    "ConversionModo": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "$ref": "#/$defs/Modo"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "de": {
          "$ref": "#/$defs/Modo"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "motivo": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Motivo",
          "type": "string"
        },
        "tras": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fase"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Desde 1.2: fase tras la que se convirtió (research o el checkpoint de spec). None solo en la primera conversión, cuando el humano fija el modo en unit.start."
        }
      },
      "required": [
        "de",
        "a",
        "actor",
        "en",
        "motivo"
      ],
      "title": "ConversionModo",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "aprobado",
        "cambios-solicitados",
        "rechazado"
      ],
      "title": "Decision",
      "type": "string"
    },
    "DecisionDelegada": {
      "additionalProperties": false,
      "description": "Registro de una decisión tomada bajo el mandato; un humano la revisa después.",
      "properties": {
        "alternativas": {
          "items": {
            "maxLength": 500,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 10,
          "title": "Alternativas",
          "type": "array"
        },
        "delegacion": {
          "description": "La delegación del mandato en que se apoya, o `reintento` (la aplica el servidor).",
          "pattern": "^(D-[0-9]{1,3}|reintento)$",
          "title": "Delegacion",
          "type": "string"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "fase": {
          "$ref": "#/$defs/Fase"
        },
        "id": {
          "description": "Decisión delegada de una unidad, p. ej. DD-3; única dentro de la unidad.",
          "pattern": "^DD-[0-9]{1,4}$",
          "title": "Id",
          "type": "string"
        },
        "orden": {
          "anyOf": [
            {
              "format": "uuid4",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "La orden durante la que se tomó.",
          "title": "Orden"
        },
        "que": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Que",
          "type": "string"
        },
        "revertir": {
          "maxLength": 1000,
          "minLength": 1,
          "title": "Revertir",
          "type": "string"
        },
        "revision": {
          "anyOf": [
            {
              "$ref": "#/$defs/RevisionDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "tomada_por": {
          "$ref": "#/$defs/Actor"
        }
      },
      "required": [
        "id",
        "delegacion",
        "que",
        "revertir",
        "fase",
        "tomada_por",
        "en"
      ],
      "title": "DecisionDelegada",
      "type": "object"
    },
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "Effort",
      "type": "string"
    },
    "EjecucionModelo": {
      "additionalProperties": false,
      "description": "Auditoría de qué modelo produjo cada contenido (antes modelo_ejecucion).",
      "properties": {
        "effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "fase": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fase"
            },
            {
              "$ref": "#/$defs/GateFase"
            }
          ],
          "title": "Fase"
        },
        "modelo": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Modelo",
          "type": "string"
        },
        "nodo": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Nodo",
          "type": "string"
        },
        "proveedor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proveedor"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None si lo ejecutó el arnés."
        },
        "rol": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Rol",
          "type": "string"
        }
      },
      "required": [
        "fase",
        "rol",
        "nodo",
        "modelo",
        "en"
      ],
      "title": "EjecucionModelo",
      "type": "object"
    },
    "EstadoFase": {
      "enum": [
        "en-progreso",
        "bloqueado",
        "completado"
      ],
      "title": "EstadoFase",
      "type": "string"
    },
    "Fase": {
      "enum": [
        "research",
        "spec",
        "plan",
        "tasks",
        "aprobacion",
        "implement",
        "done"
      ],
      "title": "Fase",
      "type": "string"
    },
    "GateFase": {
      "enum": [
        "spec",
        "plan",
        "tasks",
        "codigo"
      ],
      "title": "GateFase",
      "type": "string"
    },
    "GobernanzaConsultada": {
      "enum": [
        "si",
        "parcial",
        "no"
      ],
      "title": "GobernanzaConsultada",
      "type": "string"
    },
    "Hallazgo": {
      "additionalProperties": false,
      "properties": {
        "cita": {
          "$ref": "#/$defs/Cita"
        },
        "criterio": {
          "anyOf": [
            {
              "description": "Criterio de aceptación del spec, p. ej. CA-07.",
              "pattern": "^CA-[0-9]{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CA-NN afectado, si aplica.",
          "title": "Criterio"
        },
        "evidencia": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Evidencia",
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/GateFase"
        },
        "id": {
          "description": "Identificador del hallazgo dentro del gate, p. ej. H-12.",
          "pattern": "^H-[0-9]{1,4}$",
          "title": "Id",
          "type": "string"
        },
        "lente": {
          "description": "Lente del crítico que lo produjo.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Lente",
          "type": "string"
        },
        "propuesta": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Propuesta"
        },
        "refutado": {
          "default": false,
          "description": "True si el refutador lo descartó; un hallazgo refutado no bloquea.",
          "title": "Refutado",
          "type": "boolean"
        },
        "severidad": {
          "$ref": "#/$defs/Severidad"
        },
        "titulo": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Titulo",
          "type": "string"
        }
      },
      "required": [
        "id",
        "gate",
        "lente",
        "severidad",
        "titulo",
        "cita",
        "evidencia"
      ],
      "title": "Hallazgo",
      "type": "object"
    },
    "Integracion": {
      "additionalProperties": false,
      "description": "Estado posterior al cierre (R7): no condiciona el cierre de la unidad.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "especificacion_viva": {
          "description": "Dónde quedó consolidada la spec (ruta o id).",
          "maxLength": 512,
          "minLength": 1,
          "title": "Especificacion Viva",
          "type": "string"
        },
        "pr_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^https://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pr Url"
        }
      },
      "required": [
        "actor",
        "en",
        "especificacion_viva"
      ],
      "title": "Integracion",
      "type": "object"
    },
    "Modo": {
      "enum": [
        "interactivo",
        "semi-autonomo",
        "supervisado",
        "desatendido"
      ],
      "title": "Modo",
      "type": "string"
    },
    "NivelCodigo": {
      "description": "Política de código propietario aprobada el 2026-09-30.",
      "enum": [
        "restringido",
        "interno",
        "abierto"
      ],
      "title": "NivelCodigo",
      "type": "string"
    },
    "OidcGithubActions": {
      "additionalProperties": false,
      "description": "Identidad de servicio emitida por el token OIDC de GitHub Actions.",
      "properties": {
        "repositorio": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repositorio",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "workflow": {
          "description": "Claim workflow_ref.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "repositorio",
        "workflow"
      ],
      "title": "OidcGithubActions",
      "type": "object"
    },
    "Perfil": {
      "enum": [
        "ligero",
        "estandar",
        "profundo"
      ],
      "title": "Perfil",
      "type": "string"
    },
    "Presupuesto": {
      "additionalProperties": false,
      "description": "Tope aplicado por el servidor; al agotarse escala al humano.",
      "properties": {
        "costo_usd_max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costo Usd Max"
        },
        "llamadas_max": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Desde 1.7: tope de llamadas al modelo. Cuenta las que salen hacia el proveedor (un acierto de caché no cuenta) y, como los demás topes, escala al humano al alcanzarse.",
          "title": "Llamadas Max"
        },
        "segundos_max": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segundos Max"
        },
        "tokens_max": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Max"
        }
      },
      "title": "Presupuesto",
      "type": "object"
    },
    "Proveedor": {
      "enum": [
        "foundry",
        "anthropic",
        "compatible"
      ],
      "title": "Proveedor",
      "type": "string"
    },
    "Rehabilitacion": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "motivo": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Motivo",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "en",
        "motivo"
      ],
      "title": "Rehabilitacion",
      "type": "object"
    },
    "RepositorioUnidad": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "description": "SHA-1 completo de un commit git.",
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Commit",
          "type": "string"
        },
        "nivel_codigo": {
          "anyOf": [
            {
              "$ref": "#/$defs/NivelCodigo"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Desde 1.7: nivel de código del vínculo, fijado al crear la unidad y que no sigue a los cambios posteriores del vínculo. None = unidad anterior a 1.7: el nivel se lee del vínculo en cada uso, como hasta 1.6."
        },
        "rama": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rama"
        },
        "repositorio": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Repositorio",
          "type": "string"
        },
        "rol": {
          "$ref": "#/$defs/RolRepositorio"
        }
      },
      "required": [
        "repositorio",
        "rol",
        "base_commit"
      ],
      "title": "RepositorioUnidad",
      "type": "object"
    },
    "ResolucionCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "checkpoint": {
          "format": "uuid4",
          "title": "Checkpoint",
          "type": "string"
        },
        "comentario": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comentario"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "checkpoint",
        "decision",
        "actor",
        "en"
      ],
      "title": "ResolucionCheckpoint",
      "type": "object"
    },
    "ResultadoGate": {
      "additionalProperties": false,
      "properties": {
        "causa": {
          "anyOf": [
            {
              "$ref": "#/$defs/CausaEscalado"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cerrado_en": {
          "format": "date-time",
          "title": "Cerrado En",
          "type": "string"
        },
        "criticos": {
          "description": "Lentes del panel.",
          "items": {
            "type": "string"
          },
          "title": "Criticos",
          "type": "array"
        },
        "diferido": {
          "default": false,
          "description": "Desde 1.11: en una unidad `desatendido`, el gate escaló y la unidad se difirió (kit: `escalado: auto-deferred`): las demás unidades del mandato siguen y un humano la rehabilita después.",
          "title": "Diferido",
          "type": "boolean"
        },
        "gobernanza_consultada": {
          "$ref": "#/$defs/GobernanzaConsultada"
        },
        "hallazgos": {
          "description": "Los que quedaron sin resolver.",
          "items": {
            "$ref": "#/$defs/Hallazgo"
          },
          "title": "Hallazgos",
          "type": "array"
        },
        "iteraciones": {
          "minimum": 0,
          "title": "Iteraciones",
          "type": "integer"
        },
        "refutador": {
          "default": false,
          "title": "Refutador",
          "type": "boolean"
        },
        "rehabilitado": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rehabilitacion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "veredicto": {
          "$ref": "#/$defs/Veredicto"
        }
      },
      "required": [
        "veredicto",
        "iteraciones",
        "gobernanza_consultada",
        "cerrado_en"
      ],
      "title": "ResultadoGate",
      "type": "object"
    },
    "ResultadoRevision": {
      "enum": [
        "aceptada",
        "revertida"
      ],
      "title": "ResultadoRevision",
      "type": "string"
    },
    "RevisionDecision": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "comentario": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comentario"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "resultado": {
          "$ref": "#/$defs/ResultadoRevision"
        }
      },
      "required": [
        "resultado",
        "actor",
        "en"
      ],
      "title": "RevisionDecision",
      "type": "object"
    },
    "Riesgo": {
      "enum": [
        "bajo",
        "medio",
        "alto"
      ],
      "title": "Riesgo",
      "type": "string"
    },
    "RolRepositorio": {
      "enum": [
        "primario",
        "transversal"
      ],
      "title": "RolRepositorio",
      "type": "string"
    },
    "Severidad": {
      "enum": [
        "alta",
        "media",
        "baja"
      ],
      "title": "Severidad",
      "type": "string"
    },
    "TipoActor": {
      "enum": [
        "humano",
        "servicio",
        "agente"
      ],
      "title": "TipoActor",
      "type": "string"
    },
    "TipoCheckpoint": {
      "enum": [
        "aprobar-spec",
        "aprobar-plan",
        "paquete-aprobacion",
        "parada",
        "gate-escalado"
      ],
      "title": "TipoCheckpoint",
      "type": "string"
    },
    "Veredicto": {
      "enum": [
        "aprobado",
        "refinado",
        "escalado"
      ],
      "title": "Veredicto",
      "type": "string"
    }
  },
  "$id": "https://railspec.dev/schemas/v1/estado-unidad.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actualizado_en": {
      "format": "date-time",
      "title": "Actualizado En",
      "type": "string"
    },
    "actualizado_por": {
      "$ref": "#/$defs/Actor"
    },
    "arnes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Arnes"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None si la unidad nació en la consola."
    },
    "carril": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Carril"
    },
    "checkpoint_pendiente": {
      "anyOf": [
        {
          "$ref": "#/$defs/Checkpoint"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "comando_validacion": {
      "anyOf": [
        {
          "maxLength": 2000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Comando Validacion"
    },
    "consumo": {
      "$ref": "#/$defs/Consumo"
    },
    "creado_en": {
      "format": "date-time",
      "title": "Creado En",
      "type": "string"
    },
    "decisiones": {
      "description": "Desde 1.11: decisiones tomadas bajo el mandato de la unidad (`unidad.plan`), con su revisión humana pendiente o hecha. Solo crece.",
      "items": {
        "$ref": "#/$defs/DecisionDelegada"
      },
      "title": "Decisiones",
      "type": "array"
    },
    "depende_de": {
      "items": {
        "description": "Identificador de unidad SDD con forma NNNN-slug.",
        "pattern": "^[0-9]{4}-[a-z0-9][a-z0-9-]{0,62}$",
        "type": "string"
      },
      "title": "Depende De",
      "type": "array"
    },
    "dueno": {
      "$ref": "#/$defs/Actor"
    },
    "estado": {
      "$ref": "#/$defs/EstadoFase"
    },
    "fase": {
      "$ref": "#/$defs/Fase"
    },
    "gates": {
      "additionalProperties": {
        "$ref": "#/$defs/ResultadoGate"
      },
      "propertyNames": {
        "$ref": "#/$defs/GateFase"
      },
      "title": "Gates",
      "type": "object"
    },
    "governance_refs": {
      "items": {
        "type": "string"
      },
      "title": "Governance Refs",
      "type": "array"
    },
    "insumos": {
      "items": {
        "format": "uuid4",
        "type": "string"
      },
      "title": "Insumos",
      "type": "array"
    },
    "integracion": {
      "anyOf": [
        {
          "$ref": "#/$defs/Integracion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "modelo_ejecucion": {
      "items": {
        "$ref": "#/$defs/EjecucionModelo"
      },
      "title": "Modelo Ejecucion",
      "type": "array"
    },
    "modo": {
      "$ref": "#/$defs/Modo"
    },
    "modo_conversion": {
      "items": {
        "$ref": "#/$defs/ConversionModo"
      },
      "title": "Modo Conversion",
      "type": "array"
    },
    "nivel_efectivo": {
      "anyOf": [
        {
          "$ref": "#/$defs/NivelCodigo"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Desde 1.7: el más restrictivo de los niveles congelados de los repositorios de la unidad; rige qué material de código viaja al modelo (gate multi-repo, lectores) y no elige proveedor. None solo si ningún repositorio trae nivel (unidad anterior a 1.7)."
    },
    "orden_vigente": {
      "anyOf": [
        {
          "format": "uuid4",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Orden Vigente"
    },
    "pedido": {
      "anyOf": [
        {
          "maxLength": 20000,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Desde 1.2: el pedido original de unit.start, tal cual lo escribió el humano.",
      "title": "Pedido"
    },
    "perfil": {
      "$ref": "#/$defs/Perfil"
    },
    "presupuesto": {
      "$ref": "#/$defs/Presupuesto"
    },
    "repositorios": {
      "items": {
        "$ref": "#/$defs/RepositorioUnidad"
      },
      "minItems": 1,
      "title": "Repositorios",
      "type": "array"
    },
    "resoluciones": {
      "items": {
        "$ref": "#/$defs/ResolucionCheckpoint"
      },
      "title": "Resoluciones",
      "type": "array"
    },
    "riesgo": {
      "$ref": "#/$defs/Riesgo"
    },
    "secuencia_ordenes": {
      "default": 0,
      "minimum": 0,
      "title": "Secuencia Ordenes",
      "type": "integer"
    },
    "titulo": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Titulo",
      "type": "string"
    },
    "unidad": {
      "$ref": "#/$defs/AlcanceUnidad"
    },
    "version": {
      "description": "Bloqueo optimista; +1 en cada escritura.",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "version_contrato": {
      "default": "1.11",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5",
        "1.6",
        "1.7",
        "1.8",
        "1.9",
        "1.10",
        "1.11"
      ],
      "title": "Version Contrato",
      "type": "string"
    }
  },
  "required": [
    "unidad",
    "version",
    "titulo",
    "dueno",
    "repositorios",
    "fase",
    "estado",
    "modo",
    "riesgo",
    "perfil",
    "creado_en",
    "actualizado_en",
    "actualizado_por"
  ],
  "title": "EstadoUnidad",
  "type": "object"
}
