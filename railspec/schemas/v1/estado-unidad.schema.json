{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Quién hizo algo, por qué canal. Va en todo lo que se escribe.\n\nLa identidad estable es el id numérico de GitHub (el login puede cambiar).\nEl proveedor de identidad queda detrás de ``proveedor_identidad`` para que\notro (Azure DevOps, Entra ID) entre como valor nuevo sin romper el esquema.",
      "properties": {
        "agente": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nodo o rol del agente, si tipo=agente.",
          "title": "Agente"
        },
        "canal": {
          "$ref": "#/$defs/Canal"
        },
        "en_nombre_de": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "github_id del humano por quien actúa un agente.",
          "title": "En Nombre De"
        },
        "github_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Id"
        },
        "login": {
          "anyOf": [
            {
              "description": "Login de GitHub; informativo, la identidad es github_id.",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login"
        },
        "oidc": {
          "anyOf": [
            {
              "$ref": "#/$defs/OidcGithubActions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proveedor_identidad": {
          "default": "github",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "title": "Proveedor Identidad",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoActor"
        }
      },
      "required": [
        "tipo",
        "canal"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AlcanceUnidad": {
      "additionalProperties": false,
      "description": "Espacio de nombres de una unidad.\n\nLa unidad cuelga del workspace, no de un repositorio, porque puede\nvincular N repositorios; cada snapshot dice a cuál pertenece. ``plan``\nagrupa unidades de un mismo mandato cuando lo hay.",
      "properties": {
        "org": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Org",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "unidad": {
          "description": "Identificador de unidad SDD con forma NNNN-slug.",
          "pattern": "^[0-9]{4}-[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Unidad",
          "type": "string"
        },
        "workspace": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "org",
        "workspace",
        "unidad"
      ],
      "title": "AlcanceUnidad",
      "type": "object"
    },
    "Arnes": {
      "enum": [
        "claude-code",
        "opencode",
        "codex",
        "copilot"
      ],
      "title": "Arnes",
      "type": "string"
    },
    "Canal": {
      "enum": [
        "arnes",
        "consola",
        "ci",
        "servidor"
      ],
      "title": "Canal",
      "type": "string"
    },
    "CausaEscalado": {
      "enum": [
        "hallazgos-sin-resolver",
        "sin-gobernanza",
        "presupuesto-agotado",
        "error-proveedor"
      ],
      "title": "CausaEscalado",
      "type": "string"
    },
    "Checkpoint": {
      "additionalProperties": false,
      "description": "Decisión humana pendiente.\n\nSe resuelve por cualquier canal (elicitation en el arnés, ``unit.approve``\no la consola): gana la primera resolución que llegue y las siguientes se\nrechazan con ``checkpoint-ya-resuelto``.",
      "properties": {
        "abierto_en": {
          "format": "date-time",
          "title": "Abierto En",
          "type": "string"
        },
        "artefacto_sha256": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{64}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artefacto Sha256"
        },
        "fase": {
          "$ref": "#/$defs/Fase"
        },
        "id": {
          "format": "uuid4",
          "title": "Id",
          "type": "string"
        },
        "pregunta": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Pregunta",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoCheckpoint"
        }
      },
      "required": [
        "id",
        "tipo",
        "fase",
        "pregunta",
        "abierto_en"
      ],
      "title": "Checkpoint",
      "type": "object"
    },
    "Cita": {
      "additionalProperties": false,
      "description": "Dónde está lo que el hallazgo señala.\n\nPara artefactos (spec, plan, tasks) basta ``seccion``; para código se\nexige ``ruta`` con rango de líneas.",
      "properties": {
        "linea_fin": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linea Fin"
        },
        "linea_inicio": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linea Inicio"
        },
        "ruta": {
          "anyOf": [
            {
              "description": "Ruta relativa a la raíz del repositorio, sin '..' ni '/' inicial.",
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ruta"
        },
        "seccion": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seccion"
        }
      },
      "title": "Cita",
      "type": "object"
    },
    "Consumo": {
      "additionalProperties": false,
      "properties": {
        "costo_usd": {
          "default": 0.0,
          "minimum": 0,
          "title": "Costo Usd",
          "type": "number"
        },
        "segundos": {
          "default": 0,
          "minimum": 0,
          "title": "Segundos",
          "type": "integer"
        },
        "tokens": {
          "default": 0,
          "minimum": 0,
          "title": "Tokens",
          "type": "integer"
        }
      },
      "title": "Consumo",
      "type": "object"
    },
    "ConversionModo": {
      "additionalProperties": false,
      "properties": {
        "a": {
          "$ref": "#/$defs/Modo"
        },
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "de": {
          "$ref": "#/$defs/Modo"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "motivo": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Motivo",
          "type": "string"
        }
      },
      "required": [
        "de",
        "a",
        "actor",
        "en",
        "motivo"
      ],
      "title": "ConversionModo",
      "type": "object"
    },
    "Decision": {
      "enum": [
        "aprobado",
        "cambios-solicitados",
        "rechazado"
      ],
      "title": "Decision",
      "type": "string"
    },
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "Effort",
      "type": "string"
    },
    "EjecucionModelo": {
      "additionalProperties": false,
      "description": "Auditoría de qué modelo produjo cada contenido (antes modelo_ejecucion).",
      "properties": {
        "effort": {
          "anyOf": [
            {
              "$ref": "#/$defs/Effort"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "fase": {
          "anyOf": [
            {
              "$ref": "#/$defs/Fase"
            },
            {
              "$ref": "#/$defs/GateFase"
            }
          ],
          "title": "Fase"
        },
        "modelo": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Modelo",
          "type": "string"
        },
        "nodo": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Nodo",
          "type": "string"
        },
        "proveedor": {
          "anyOf": [
            {
              "$ref": "#/$defs/Proveedor"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "None si lo ejecutó el arnés."
        },
        "rol": {
          "maxLength": 80,
          "minLength": 1,
          "title": "Rol",
          "type": "string"
        }
      },
      "required": [
        "fase",
        "rol",
        "nodo",
        "modelo",
        "en"
      ],
      "title": "EjecucionModelo",
      "type": "object"
    },
    "EstadoFase": {
      "enum": [
        "en-progreso",
        "bloqueado",
        "completado"
      ],
      "title": "EstadoFase",
      "type": "string"
    },
    "Fase": {
      "enum": [
        "research",
        "spec",
        "plan",
        "tasks",
        "aprobacion",
        "implement",
        "done"
      ],
      "title": "Fase",
      "type": "string"
    },
    "GateFase": {
      "enum": [
        "spec",
        "plan",
        "tasks",
        "codigo"
      ],
      "title": "GateFase",
      "type": "string"
    },
    "GobernanzaConsultada": {
      "enum": [
        "si",
        "parcial",
        "no"
      ],
      "title": "GobernanzaConsultada",
      "type": "string"
    },
    "Hallazgo": {
      "additionalProperties": false,
      "properties": {
        "cita": {
          "$ref": "#/$defs/Cita"
        },
        "criterio": {
          "anyOf": [
            {
              "description": "Criterio de aceptación del spec, p. ej. CA-07.",
              "pattern": "^CA-[0-9]{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CA-NN afectado, si aplica.",
          "title": "Criterio"
        },
        "evidencia": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Evidencia",
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/GateFase"
        },
        "id": {
          "description": "Identificador del hallazgo dentro del gate, p. ej. H-12.",
          "pattern": "^H-[0-9]{1,4}$",
          "title": "Id",
          "type": "string"
        },
        "lente": {
          "description": "Lente del crítico que lo produjo.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Lente",
          "type": "string"
        },
        "propuesta": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Propuesta"
        },
        "refutado": {
          "default": false,
          "description": "True si el refutador lo descartó; un hallazgo refutado no bloquea.",
          "title": "Refutado",
          "type": "boolean"
        },
        "severidad": {
          "$ref": "#/$defs/Severidad"
        },
        "titulo": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Titulo",
          "type": "string"
        }
      },
      "required": [
        "id",
        "gate",
        "lente",
        "severidad",
        "titulo",
        "cita",
        "evidencia"
      ],
      "title": "Hallazgo",
      "type": "object"
    },
    "Integracion": {
      "additionalProperties": false,
      "description": "Estado posterior al cierre (R7): no condiciona el cierre de la unidad.",
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "especificacion_viva": {
          "description": "Dónde quedó consolidada la spec (ruta o id).",
          "maxLength": 512,
          "minLength": 1,
          "title": "Especificacion Viva",
          "type": "string"
        },
        "pr_url": {
          "anyOf": [
            {
              "maxLength": 512,
              "pattern": "^https://",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pr Url"
        }
      },
      "required": [
        "actor",
        "en",
        "especificacion_viva"
      ],
      "title": "Integracion",
      "type": "object"
    },
    "Modo": {
      "enum": [
        "interactivo",
        "semi-autonomo",
        "supervisado",
        "desatendido"
      ],
      "title": "Modo",
      "type": "string"
    },
    "OidcGithubActions": {
      "additionalProperties": false,
      "description": "Identidad de servicio emitida por el token OIDC de GitHub Actions.",
      "properties": {
        "repositorio": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repositorio",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "workflow": {
          "description": "Claim workflow_ref.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "repositorio",
        "workflow"
      ],
      "title": "OidcGithubActions",
      "type": "object"
    },
    "Perfil": {
      "enum": [
        "ligero",
        "estandar",
        "profundo"
      ],
      "title": "Perfil",
      "type": "string"
    },
    "Presupuesto": {
      "additionalProperties": false,
      "description": "Tope aplicado por el servidor; al agotarse escala al humano.",
      "properties": {
        "costo_usd_max": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Costo Usd Max"
        },
        "segundos_max": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Segundos Max"
        },
        "tokens_max": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tokens Max"
        }
      },
      "title": "Presupuesto",
      "type": "object"
    },
    "Proveedor": {
      "enum": [
        "foundry",
        "anthropic"
      ],
      "title": "Proveedor",
      "type": "string"
    },
    "Rehabilitacion": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "motivo": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Motivo",
          "type": "string"
        }
      },
      "required": [
        "actor",
        "en",
        "motivo"
      ],
      "title": "Rehabilitacion",
      "type": "object"
    },
    "RepositorioUnidad": {
      "additionalProperties": false,
      "properties": {
        "base_commit": {
          "description": "SHA-1 completo de un commit git.",
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Commit",
          "type": "string"
        },
        "rama": {
          "anyOf": [
            {
              "maxLength": 255,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Rama"
        },
        "repositorio": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Repositorio",
          "type": "string"
        },
        "rol": {
          "$ref": "#/$defs/RolRepositorio"
        }
      },
      "required": [
        "repositorio",
        "rol",
        "base_commit"
      ],
      "title": "RepositorioUnidad",
      "type": "object"
    },
    "ResolucionCheckpoint": {
      "additionalProperties": false,
      "properties": {
        "actor": {
          "$ref": "#/$defs/Actor"
        },
        "checkpoint": {
          "format": "uuid4",
          "title": "Checkpoint",
          "type": "string"
        },
        "comentario": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comentario"
        },
        "decision": {
          "$ref": "#/$defs/Decision"
        },
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        }
      },
      "required": [
        "checkpoint",
        "decision",
        "actor",
        "en"
      ],
      "title": "ResolucionCheckpoint",
      "type": "object"
    },
    "ResultadoGate": {
      "additionalProperties": false,
      "properties": {
        "causa": {
          "anyOf": [
            {
              "$ref": "#/$defs/CausaEscalado"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "cerrado_en": {
          "format": "date-time",
          "title": "Cerrado En",
          "type": "string"
        },
        "criticos": {
          "description": "Lentes del panel.",
          "items": {
            "type": "string"
          },
          "title": "Criticos",
          "type": "array"
        },
        "gobernanza_consultada": {
          "$ref": "#/$defs/GobernanzaConsultada"
        },
        "hallazgos": {
          "description": "Los que quedaron sin resolver.",
          "items": {
            "$ref": "#/$defs/Hallazgo"
          },
          "title": "Hallazgos",
          "type": "array"
        },
        "iteraciones": {
          "minimum": 0,
          "title": "Iteraciones",
          "type": "integer"
        },
        "refutador": {
          "default": false,
          "title": "Refutador",
          "type": "boolean"
        },
        "rehabilitado": {
          "anyOf": [
            {
              "$ref": "#/$defs/Rehabilitacion"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "veredicto": {
          "$ref": "#/$defs/Veredicto"
        }
      },
      "required": [
        "veredicto",
        "iteraciones",
        "gobernanza_consultada",
        "cerrado_en"
      ],
      "title": "ResultadoGate",
      "type": "object"
    },
    "Riesgo": {
      "enum": [
        "bajo",
        "medio",
        "alto"
      ],
      "title": "Riesgo",
      "type": "string"
    },
    "RolRepositorio": {
      "enum": [
        "primario",
        "transversal"
      ],
      "title": "RolRepositorio",
      "type": "string"
    },
    "Severidad": {
      "enum": [
        "alta",
        "media",
        "baja"
      ],
      "title": "Severidad",
      "type": "string"
    },
    "TipoActor": {
      "enum": [
        "humano",
        "servicio",
        "agente"
      ],
      "title": "TipoActor",
      "type": "string"
    },
    "TipoCheckpoint": {
      "enum": [
        "aprobar-spec",
        "aprobar-plan",
        "paquete-aprobacion",
        "parada",
        "gate-escalado"
      ],
      "title": "TipoCheckpoint",
      "type": "string"
    },
    "Veredicto": {
      "enum": [
        "aprobado",
        "refinado",
        "escalado"
      ],
      "title": "Veredicto",
      "type": "string"
    }
  },
  "$id": "https://railspec.dev/schemas/v1/estado-unidad.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actualizado_en": {
      "format": "date-time",
      "title": "Actualizado En",
      "type": "string"
    },
    "actualizado_por": {
      "$ref": "#/$defs/Actor"
    },
    "arnes": {
      "anyOf": [
        {
          "$ref": "#/$defs/Arnes"
        },
        {
          "type": "null"
        }
      ],
