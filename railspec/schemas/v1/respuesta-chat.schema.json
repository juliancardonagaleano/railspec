{
  "$defs": {
    "Afirmacion": {
      "additionalProperties": false,
      "properties": {
        "referencias": {
          "items": {
            "discriminator": {
              "mapping": {
                "archivo": "#/$defs/RefArchivo",
                "criterio": "#/$defs/RefCriterio",
                "decision": "#/$defs/RefDecision",
                "gobernanza": "#/$defs/RefGobernanza",
                "nodo-grafo": "#/$defs/RefNodoGrafo",
                "simbolo": "#/$defs/RefSimbolo",
                "unidad": "#/$defs/RefUnidad"
              },
              "propertyName": "tipo"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RefSimbolo"
              },
              {
                "$ref": "#/$defs/RefArchivo"
              },
              {
                "$ref": "#/$defs/RefNodoGrafo"
              },
              {
                "$ref": "#/$defs/RefUnidad"
              },
              {
                "$ref": "#/$defs/RefCriterio"
              },
              {
                "$ref": "#/$defs/RefGobernanza"
              },
              {
                "$ref": "#/$defs/RefDecision"
              }
            ]
          },
          "maxItems": 20,
          "title": "Referencias",
          "type": "array"
        },
        "texto": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Texto",
          "type": "string"
        }
      },
      "required": [
        "texto"
      ],
      "title": "Afirmacion",
      "type": "object"
    },
    "RefArchivo": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "description": "SHA-1 completo de un commit git.",
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "linea_fin": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linea Fin"
        },
        "linea_inicio": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linea Inicio"
        },
        "repositorio": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Repositorio",
          "type": "string"
        },
        "ruta": {
          "description": "Ruta relativa a la raíz del repositorio, sin '..' ni '/' inicial.",
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]+$",
          "title": "Ruta",
          "type": "string"
        },
        "tipo": {
          "const": "archivo",
          "default": "archivo",
          "title": "Tipo",
          "type": "string"
        }
      },
      "required": [
        "repositorio",
        "commit",
        "ruta"
      ],
      "title": "RefArchivo",
      "type": "object"
    },
    "RefCriterio": {
      "additionalProperties": false,
      "properties": {
        "criterio": {
          "description": "Criterio de aceptación del spec, p. ej. CA-07.",
          "pattern": "^CA-[0-9]{2,3}$",
          "title": "Criterio",
          "type": "string"
        },
        "tipo": {
          "const": "criterio",
          "default": "criterio",
          "title": "Tipo",
          "type": "string"
        },
        "unidad": {
          "description": "Identificador de unidad SDD con forma NNNN-slug.",
          "pattern": "^[0-9]{4}-[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Unidad",
          "type": "string"
        },
        "workspace": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "unidad",
        "criterio"
      ],
      "title": "RefCriterio",
      "type": "object"
    },
    "RefDecision": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "tipo": {
          "const": "decision",
          "default": "decision",
          "title": "Tipo",
          "type": "string"
        },
        "workspace": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "id"
      ],
      "title": "RefDecision",
      "type": "object"
    },
    "RefGobernanza": {
      "additionalProperties": false,
      "properties": {
        "hash_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash Version"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "proveedor": {
          "default": "pce",
          "maxLength": 80,
          "minLength": 1,
          "title": "Proveedor",
          "type": "string"
        },
        "tipo": {
          "const": "gobernanza",
          "default": "gobernanza",
          "title": "Tipo",
          "type": "string"
        }
      },
      "required": [
        "id"
      ],
      "title": "RefGobernanza",
      "type": "object"
    },
    "RefNodoGrafo": {
      "additionalProperties": false,
      "description": "Nodo de la capa remota (cluster, proceso) que no es un símbolo.",
      "properties": {
        "clase": {
          "enum": [
            "cluster",
            "proceso"
          ],
          "title": "Clase",
          "type": "string"
        },
        "commit": {
          "description": "SHA-1 completo de un commit git.",
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "nombre": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Nombre",
          "type": "string"
        },
        "repositorio": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Repositorio",
          "type": "string"
        },
        "tipo": {
          "const": "nodo-grafo",
          "default": "nodo-grafo",
          "title": "Tipo",
          "type": "string"
        }
      },
      "required": [
        "repositorio",
        "commit",
        "clase",
        "id",
        "nombre"
      ],
      "title": "RefNodoGrafo",
      "type": "object"
    },
    "RefSimbolo": {
      "additionalProperties": false,
      "properties": {
        "commit": {
          "description": "SHA-1 completo de un commit git.",
          "pattern": "^[0-9a-f]{40}$",
          "title": "Commit",
          "type": "string"
        },
        "nombre": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Nombre",
          "type": "string"
        },
        "repositorio": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Repositorio",
          "type": "string"
        },
        "ruta": {
          "description": "Ruta relativa a la raíz del repositorio, sin '..' ni '/' inicial.",
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]+$",
          "title": "Ruta",
          "type": "string"
        },
        "simbolo": {
          "description": "Identificador estable del símbolo: SHA-256 de '<repositorio>\\0<ruta>\\0<tipo>\\0<nombre calificado>'.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Simbolo",
          "type": "string"
        },
        "tipo": {
          "const": "simbolo",
          "default": "simbolo",
          "title": "Tipo",
          "type": "string"
        },
        "tipo_simbolo": {
          "$ref": "#/$defs/TipoSimbolo"
        }
      },
      "required": [
        "repositorio",
        "commit",
        "simbolo",
        "nombre",
        "tipo_simbolo",
        "ruta"
      ],
      "title": "RefSimbolo",
      "type": "object"
    },
    "RefUnidad": {
      "additionalProperties": false,
      "properties": {
        "tipo": {
          "const": "unidad",
          "default": "unidad",
          "title": "Tipo",
          "type": "string"
        },
        "unidad": {
          "description": "Identificador de unidad SDD con forma NNNN-slug.",
          "pattern": "^[0-9]{4}-[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Unidad",
          "type": "string"
        },
        "workspace": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "workspace",
        "unidad"
      ],
      "title": "RefUnidad",
      "type": "object"
    },
    "TipoSimbolo": {
      "enum": [
        "modulo",
        "clase",
        "interfaz",
        "funcion",
        "metodo",
        "variable",
        "otro"
      ],
      "title": "TipoSimbolo",
      "type": "string"
    }
  },
  "$id": "https://railspec.dev/schemas/v1/respuesta-chat.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Lo único que el modelo del chat puede devolver.",
  "properties": {
    "afirmaciones": {
      "items": {
        "$ref": "#/$defs/Afirmacion"
      },
      "maxItems": 30,
      "minItems": 1,
      "title": "Afirmaciones",
      "type": "array"
    },
    "preguntas_abiertas": {
      "items": {
        "type": "string"
      },
      "maxItems": 10,
      "title": "Preguntas Abiertas",
      "type": "array"
    }
  },
  "required": [
    "afirmaciones"
  ],
  "title": "RespuestaChat",
  "type": "object"
}
