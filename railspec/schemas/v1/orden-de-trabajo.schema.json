{
  "$defs": {
    "Afirmacion": {
      "additionalProperties": false,
      "properties": {
        "referencias": {
          "items": {
            "discriminator": {
              "mapping": {
                "archivo": "#/$defs/RefArchivo",
                "criterio": "#/$defs/RefCriterio",
                "decision": "#/$defs/RefDecision",
                "gobernanza": "#/$defs/RefGobernanza",
                "nodo-grafo": "#/$defs/RefNodoGrafo",
                "simbolo": "#/$defs/RefSimbolo",
                "unidad": "#/$defs/RefUnidad"
              },
              "propertyName": "tipo"
            },
            "oneOf": [
              {
                "$ref": "#/$defs/RefSimbolo"
              },
              {
                "$ref": "#/$defs/RefArchivo"
              },
              {
                "$ref": "#/$defs/RefNodoGrafo"
              },
              {
                "$ref": "#/$defs/RefUnidad"
              },
              {
                "$ref": "#/$defs/RefCriterio"
              },
              {
                "$ref": "#/$defs/RefGobernanza"
              },
              {
                "$ref": "#/$defs/RefDecision"
              }
            ]
          },
          "maxItems": 20,
          "title": "Referencias",
          "type": "array"
        },
        "texto": {
          "maxLength": 1200,
          "minLength": 1,
          "title": "Texto",
          "type": "string"
        }
      },
      "required": [
        "texto"
      ],
      "title": "Afirmacion",
      "type": "object"
    },
    "AlcanceArchivos": {
      "additionalProperties": false,
      "properties": {
        "permitidos": {
          "items": {
            "description": "Patrón glob relativo a la raíz del repositorio (sintaxis gitignore).",
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]+$",
            "type": "string"
          },
          "title": "Permitidos",
          "type": "array"
        },
        "prohibidos": {
          "items": {
            "description": "Patrón glob relativo a la raíz del repositorio (sintaxis gitignore).",
            "maxLength": 512,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]+$",
            "type": "string"
          },
          "title": "Prohibidos",
          "type": "array"
        }
      },
      "title": "AlcanceArchivos",
      "type": "object"
    },
    "AlcanceUnidad": {
      "additionalProperties": false,
      "description": "Espacio de nombres de una unidad.\n\nLa unidad cuelga del workspace, no de un repositorio, porque puede\nvincular N repositorios; cada snapshot dice a cuál pertenece. ``plan``\nagrupa unidades de un mismo mandato cuando lo hay.",
      "properties": {
        "org": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Org",
          "type": "string"
        },
        "plan": {
          "anyOf": [
            {
              "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
              "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Plan"
        },
        "unidad": {
          "description": "Identificador de unidad SDD con forma NNNN-slug.",
          "pattern": "^[0-9]{4}-[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Unidad",
          "type": "string"
        },
        "workspace": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "org",
        "workspace",
        "unidad"
      ],
      "title": "AlcanceUnidad",
      "type": "object"
    },
    "Artefacto": {
      "enum": [
        "spec",
        "plan",
        "tasks"
      ],
      "title": "Artefacto",
      "type": "string"
    },
    "Cita": {
      "additionalProperties": false,
      "description": "Dónde está lo que el hallazgo señala.\n\nPara artefactos (spec, plan, tasks) basta ``seccion``; para código se\nexige ``ruta`` con rango de líneas.",
      "properties": {
        "linea_fin": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linea Fin"
        },
        "linea_inicio": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Linea Inicio"
        },
        "ruta": {
          "anyOf": [
            {
              "description": "Ruta relativa a la raíz del repositorio, sin '..' ni '/' inicial.",
              "maxLength": 1024,
              "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Ruta"
        },
        "seccion": {
          "anyOf": [
            {
              "maxLength": 200,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Seccion"
        }
      },
      "title": "Cita",
      "type": "object"
    },
    "Complejidad": {
      "enum": [
        "simple",
        "complejo"
      ],
      "title": "Complejidad",
      "type": "string"
    },
    "ContextoArmado": {
      "additionalProperties": false,
      "properties": {
        "gobernanza": {
          "items": {
            "$ref": "#/$defs/ItemGobernanza"
          },
          "title": "Gobernanza",
          "type": "array"
        },
        "gobernanza_consultada": {
          "$ref": "#/$defs/GobernanzaConsultada"
        },
        "grafo": {
          "items": {
            "$ref": "#/$defs/NodoContexto"
          },
          "title": "Grafo",
          "type": "array"
        },
        "hallazgos_previos": {
          "description": "Hallazgos de la iteración anterior (gate_delta).",
          "items": {
            "$ref": "#/$defs/Hallazgo"
          },
          "title": "Hallazgos Previos",
          "type": "array"
        },
        "insumos": {
          "description": "Insumos del chat resueltos contra base_commit (R6).",
          "items": {
            "$ref": "#/$defs/InsumoResuelto"
          },
          "title": "Insumos",
          "type": "array"
        },
        "notas": {
          "anyOf": [
            {
              "maxLength": 8000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Notas"
        }
      },
      "required": [
        "gobernanza_consultada"
      ],
      "title": "ContextoArmado",
      "type": "object"
    },
    "Criterio": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "description": "Criterio de aceptación del spec, p. ej. CA-07.",
          "pattern": "^CA-[0-9]{2,3}$",
          "title": "Id",
          "type": "string"
        },
        "texto": {
          "maxLength": 2000,
          "minLength": 1,
          "title": "Texto",
          "type": "string"
        }
      },
      "required": [
        "id",
        "texto"
      ],
      "title": "Criterio",
      "type": "object"
    },
    "Fase": {
      "enum": [
        "research",
        "spec",
        "plan",
        "tasks",
        "aprobacion",
        "implement",
        "done"
      ],
      "title": "Fase",
      "type": "string"
    },
    "GateFase": {
      "enum": [
        "spec",
        "plan",
        "tasks",
        "codigo"
      ],
      "title": "GateFase",
      "type": "string"
    },
    "GobernanzaConsultada": {
      "enum": [
        "si",
        "parcial",
        "no"
      ],
      "title": "GobernanzaConsultada",
      "type": "string"
    },
    "Hallazgo": {
      "additionalProperties": false,
      "properties": {
        "cita": {
          "$ref": "#/$defs/Cita"
        },
        "criterio": {
          "anyOf": [
            {
              "description": "Criterio de aceptación del spec, p. ej. CA-07.",
              "pattern": "^CA-[0-9]{2,3}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "CA-NN afectado, si aplica.",
          "title": "Criterio"
        },
        "evidencia": {
          "maxLength": 4000,
          "minLength": 1,
          "title": "Evidencia",
          "type": "string"
        },
        "gate": {
          "$ref": "#/$defs/GateFase"
        },
        "id": {
          "description": "Identificador del hallazgo dentro del gate, p. ej. H-12.",
          "pattern": "^H-[0-9]{1,4}$",
          "title": "Id",
          "type": "string"
        },
        "lente": {
          "description": "Lente del crítico que lo produjo.",
          "maxLength": 80,
          "minLength": 1,
          "title": "Lente",
          "type": "string"
        },
        "propuesta": {
          "anyOf": [
            {
              "maxLength": 4000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Propuesta"
        },
        "refutado": {
          "default": false,
          "description": "True si el refutador lo descartó; un hallazgo refutado no bloquea.",
          "title": "Refutado",
          "type": "boolean"
        },
        "severidad": {
          "$ref": "#/$defs/Severidad"
        },
        "titulo": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Titulo",
          "type": "string"
        }
      },
      "required": [
        "id",
        "gate",
        "lente",
        "severidad",
        "titulo",
        "cita",
        "evidencia"
      ],
      "title": "Hallazgo",
      "type": "object"
    },
    "InsumoResuelto": {
      "additionalProperties": false,
      "description": "Lo que entra en ``contexto.insumos`` de una orden de trabajo.",
      "properties": {
        "hallazgos": {
          "items": {
            "$ref": "#/$defs/Afirmacion"
          },
          "title": "Hallazgos",
          "type": "array"
        },
        "id": {
          "format": "uuid4",
          "title": "Id",
          "type": "string"
        },
        "objetivo": {
          "maxLength": 600,
          "minLength": 1,
          "title": "Objetivo",
          "type": "string"
        },
        "referencias": {
          "items": {
            "$ref": "#/$defs/ReferenciaResuelta"
          },
          "title": "Referencias",
          "type": "array"
        },
        "restricciones": {
          "items": {
            "type": "string"
          },
          "title": "Restricciones",
          "type": "array"
        },
        "sha256": {
          "description": "SHA-256 en hexadecimal.",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "id",
        "sha256",
        "objetivo"
      ],
      "title": "InsumoResuelto",
      "type": "object"
    },
    "ItemGobernanza": {
      "additionalProperties": false,
      "description": "Entrada de gobernanza aplicable (ADR, policy, principio).",
      "properties": {
        "hash_version": {
          "anyOf": [
            {
              "maxLength": 128,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Hash Version"
        },
        "id": {
          "maxLength": 200,
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "resumen": {
          "maxLength": 4000,
          "title": "Resumen",
          "type": "string"
        },
        "tipo": {
          "maxLength": 40,
          "minLength": 1,
          "title": "Tipo",
          "type": "string"
        },
        "titulo": {
          "maxLength": 300,
          "minLength": 1,
          "title": "Titulo",
          "type": "string"
        }
      },
      "required": [
        "id",
        "tipo",
        "titulo",
        "resumen"
      ],
      "title": "ItemGobernanza",
      "type": "object"
    },
    "NodoContexto": {
      "additionalProperties": false,
      "description": "Nodo de la rebanada del grafo. Nunca lleva texto de código.",
      "properties": {
        "motivo": {
          "description": "Por qué entra en la rebanada (impacto, llamada, prueba…).",
          "maxLength": 300,
          "title": "Motivo",
          "type": "string"
        },
        "nombre": {
          "maxLength": 512,
          "minLength": 1,
          "title": "Nombre",
          "type": "string"
        },
        "repositorio": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Repositorio",
          "type": "string"
        },
        "rol": {
          "$ref": "#/$defs/RolRepositorio"
        },
        "ruta": {
          "description": "Ruta relativa a la raíz del repositorio, sin '..' ni '/' inicial.",
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]+$",
          "title": "Ruta",
          "type": "string"
        },
        "simbolo": {
          "description": "Identificador estable del símbolo: SHA-256 de '<repositorio>\\0<ruta>\\0<tipo>\\0<nombre calificado>', con el slug del repositorio tal como está vinculado en el workspace. Ver id_simbolo().",
          "pattern": "^[0-9a-f]{64}$",
          "title": "Simbolo",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoSimbolo"
        }
      },
      "required": [
        "repositorio",
        "rol",
        "simbolo",
        "nombre",
        "tipo",
        "ruta",
        "motivo"
      ],
      "title": "NodoContexto",
      "type": "object"
    },
    "OrdenImplementar": {
      "additionalProperties": false,
      "description": "Implementar un grupo de tareas en el worktree de la unidad.",
      "properties": {
        "alcance": {
          "$ref": "#/$defs/AlcanceArchivos"
        },
        "base_commit": {
          "description": "SHA-1 completo de un commit git.",
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Commit",
          "type": "string"
        },
        "comando_validacion": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comando Validacion"
        },
        "complejidad": {
          "$ref": "#/$defs/Complejidad",
          "default": "simple"
        },
        "contexto": {
          "$ref": "#/$defs/ContextoArmado"
        },
        "criterios": {
          "items": {
            "$ref": "#/$defs/Criterio"
          },
          "title": "Criterios",
          "type": "array"
        },
        "emitida_en": {
          "format": "date-time",
          "title": "Emitida En",
          "type": "string"
        },
        "expira_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expira En"
        },
        "fase": {
          "$ref": "#/$defs/Fase"
        },
        "grupo": {
          "description": "Grupo de tareas del plan, p. ej. G1.",
          "pattern": "^G[0-9]{1,2}$",
          "title": "Grupo",
          "type": "string"
        },
        "id": {
          "format": "uuid4",
          "title": "Id",
          "type": "string"
        },
        "instrucciones": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Instrucciones",
          "type": "string"
        },
        "presupuesto": {
          "$ref": "#/$defs/Presupuesto"
        },
        "reporte_requerido": {
          "$ref": "#/$defs/ReporteRequerido"
        },
        "repositorio": {
          "description": "Repositorio primario donde se ejecuta la orden.",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Repositorio",
          "type": "string"
        },
        "secuencia": {
          "description": "Monótona por unidad; la vigente es la mayor.",
          "minimum": 1,
          "title": "Secuencia",
          "type": "integer"
        },
        "tareas": {
          "items": {
            "$ref": "#/$defs/Tarea"
          },
          "minItems": 1,
          "title": "Tareas",
          "type": "array"
        },
        "tipo": {
          "const": "implementar",
          "default": "implementar",
          "title": "Tipo",
          "type": "string"
        },
        "unidad": {
          "$ref": "#/$defs/AlcanceUnidad"
        },
        "version_contrato": {
          "default": "1.7",
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3",
            "1.4",
            "1.5",
            "1.6",
            "1.7"
          ],
          "title": "Version Contrato",
          "type": "string"
        }
      },
      "required": [
        "id",
        "secuencia",
        "unidad",
        "repositorio",
        "base_commit",
        "fase",
        "emitida_en",
        "instrucciones",
        "contexto",
        "grupo",
        "tareas"
      ],
      "title": "OrdenImplementar",
      "type": "object"
    },
    "OrdenRedactar": {
      "additionalProperties": false,
      "description": "Redactar un artefacto del protocolo (spec, plan o tasks).",
      "properties": {
        "alcance": {
          "$ref": "#/$defs/AlcanceArchivos"
        },
        "artefacto": {
          "$ref": "#/$defs/Artefacto"
        },
        "base_commit": {
          "description": "SHA-1 completo de un commit git.",
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Commit",
          "type": "string"
        },
        "comando_validacion": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comando Validacion"
        },
        "contexto": {
          "$ref": "#/$defs/ContextoArmado"
        },
        "criterios": {
          "items": {
            "$ref": "#/$defs/Criterio"
          },
          "title": "Criterios",
          "type": "array"
        },
        "delegable": {
          "default": true,
          "description": "Si el arnés puede pedir al servidor que redacte en su lugar.",
          "title": "Delegable",
          "type": "boolean"
        },
        "emitida_en": {
          "format": "date-time",
          "title": "Emitida En",
          "type": "string"
        },
        "expira_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Expira En"
        },
        "fase": {
          "$ref": "#/$defs/Fase"
        },
        "id": {
          "format": "uuid4",
          "title": "Id",
          "type": "string"
        },
        "instrucciones": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Instrucciones",
          "type": "string"
        },
        "plantilla": {
          "maxLength": 40000,
          "title": "Plantilla",
          "type": "string"
        },
        "presupuesto": {
          "$ref": "#/$defs/Presupuesto"
        },
        "reporte_requerido": {
          "$ref": "#/$defs/ReporteRequerido"
        },
        "repositorio": {
          "description": "Repositorio primario donde se ejecuta la orden.",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Repositorio",
          "type": "string"
        },
        "ruta_artefacto": {
          "description": "Ruta relativa a la raíz del repositorio, sin '..' ni '/' inicial.",
          "maxLength": 1024,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\x00]+$",
          "title": "Ruta Artefacto",
          "type": "string"
        },
        "secuencia": {
          "description": "Monótona por unidad; la vigente es la mayor.",
          "minimum": 1,
          "title": "Secuencia",
          "type": "integer"
        },
        "tipo": {
          "const": "redactar",
          "default": "redactar",
          "title": "Tipo",
          "type": "string"
        },
        "unidad": {
          "$ref": "#/$defs/AlcanceUnidad"
        },
        "version_contrato": {
          "default": "1.7",
          "enum": [
            "1.0",
            "1.1",
            "1.2",
            "1.3",
            "1.4",
            "1.5",
            "1.6",
            "1.7"
          ],
          "title": "Version Contrato",
          "type": "string"
        }
      },
      "required": [
        "id",
        "secuencia",
        "unidad",
        "repositorio",
        "base_commit",
        "fase",
        "emitida_en",
        "instrucciones",
        "contexto",
        "artefacto",
        "ruta_artefacto",
        "plantilla"
      ],
      "title": "OrdenRedactar",
      "type": "object"
    },
    "OrdenRefinar": {
      "additionalProperties": false,
      "description": "Corregir un artefacto ya redactado según hallazgos del gate.",
      "properties": {
        "alcance": {
          "$ref": "#/$defs/AlcanceArchivos"
        },
        "artefacto": {
          "$ref": "#/$defs/Artefacto"
        },
        "base_commit": {
          "description": "SHA-1 completo de un commit git.",
          "pattern": "^[0-9a-f]{40}$",
          "title": "Base Commit",
          "type": "string"
        },
        "comando_validacion": {
          "anyOf": [
            {
              "maxLength": 2000,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comando Validacion"
        },
        "contexto": {
