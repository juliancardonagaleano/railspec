{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Quién hizo algo, por qué canal. Va en todo lo que se escribe.\n\nLa identidad estable es el id numérico de GitHub (el login puede cambiar).\nEl proveedor de identidad queda detrás de ``proveedor_identidad`` para que\notro (Azure DevOps, Entra ID) entre como valor nuevo sin romper el esquema.",
      "properties": {
        "agente": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nodo o rol del agente, si tipo=agente.",
          "title": "Agente"
        },
        "canal": {
          "$ref": "#/$defs/Canal"
        },
        "en_nombre_de": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "github_id del humano por quien actúa un agente.",
          "title": "En Nombre De"
        },
        "github_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Id"
        },
        "login": {
          "anyOf": [
            {
              "description": "Login de GitHub; informativo, la identidad es github_id.",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login"
        },
        "oidc": {
          "anyOf": [
            {
              "$ref": "#/$defs/OidcGithubActions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proveedor_identidad": {
          "default": "github",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "title": "Proveedor Identidad",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoActor"
        }
      },
      "required": [
        "tipo",
        "canal"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Auditoria": {
      "additionalProperties": false,
      "properties": {
        "actualizado_en": {
          "format": "date-time",
          "title": "Actualizado En",
          "type": "string"
        },
        "actualizado_por": {
          "$ref": "#/$defs/Actor"
        },
        "creado_en": {
          "format": "date-time",
          "title": "Creado En",
          "type": "string"
        },
        "creado_por": {
          "$ref": "#/$defs/Actor"
        }
      },
      "required": [
        "creado_por",
        "creado_en",
        "actualizado_por",
        "actualizado_en"
      ],
      "title": "Auditoria",
      "type": "object"
    },
    "AutenticacionSuscripcion": {
      "enum": [
        "api-key",
        "identidad-servidor"
      ],
      "title": "AutenticacionSuscripcion",
      "type": "string"
    },
    "Canal": {
      "enum": [
        "arnes",
        "consola",
        "ci",
        "servidor"
      ],
      "title": "Canal",
      "type": "string"
    },
    "Capacidades": {
      "additionalProperties": false,
      "properties": {
        "contexto_max_tokens": {
          "minimum": 1,
          "title": "Contexto Max Tokens",
          "type": "integer"
        },
        "efforts": {
          "items": {
            "$ref": "#/$defs/Effort"
          },
          "title": "Efforts",
          "type": "array"
        },
        "structured_outputs": {
          "default": false,
          "title": "Structured Outputs",
          "type": "boolean"
        },
        "thinking": {
          "default": false,
          "title": "Thinking",
          "type": "boolean"
        }
      },
      "required": [
        "contexto_max_tokens"
      ],
      "title": "Capacidades",
      "type": "object"
    },
    "Effort": {
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh",
        "max"
      ],
      "title": "Effort",
      "type": "string"
    },
    "LecturaSuscripcion": {
      "additionalProperties": false,
      "description": "Resultado del último descubrimiento de modelos de una suscripción; el error ya viene saneado.",
      "properties": {
        "en": {
          "format": "date-time",
          "title": "En",
          "type": "string"
        },
        "error_codigo": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Codigo"
        },
        "error_detalle": {
          "anyOf": [
            {
              "maxLength": 500,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Error Detalle"
        },
        "modelos": {
          "minimum": 0,
          "title": "Modelos",
          "type": "integer"
        },
        "por": {
          "anyOf": [
            {
              "maxLength": 100,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Por"
        },
        "resultado": {
          "enum": [
            "ok",
            "error"
          ],
          "title": "Resultado",
          "type": "string"
        }
      },
      "required": [
        "en",
        "resultado",
        "modelos"
      ],
      "title": "LecturaSuscripcion",
      "type": "object"
    },
    "ModeloSuscripcion": {
      "additionalProperties": false,
      "description": "Un modelo (o despliegue de Foundry) de una suscripción, elegible o no como modelo disponible.\n\n``origen`` ``descubierto`` sale de la API del proveedor; ``declarado`` lo escribe un administrador\n(un despliegue que la API no lista o unas capacidades que la API no da) y gana sobre el descubierto\nde la misma clave. ``region`` se deriva de la suscripción y del SKU (Foundry): ``global``,\n``zona-<zona>`` o la región del recurso; ``None`` si no se puede saber. La región se audita y no\nrestringe qué repositorios sirve el modelo. ``ausente``: estaba elegido y la última lectura ya no lo trae.",
      "properties": {
        "ausente": {
          "default": false,
          "title": "Ausente",
          "type": "boolean"
        },
        "capacidades": {
          "$ref": "#/$defs/Capacidades"
        },
        "despliegue": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nombre en Foundry.",
          "title": "Despliegue"
        },
        "modelo": {
          "maxLength": 120,
          "minLength": 1,
          "title": "Modelo",
          "type": "string"
        },
        "origen": {
          "enum": [
            "descubierto",
            "declarado"
          ],
          "title": "Origen",
          "type": "string"
        },
        "precio_usd_mtok": {
          "anyOf": [
            {
              "$ref": "#/$defs/PrecioModelo"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Desde 1.8: sin tarifa, el modelo cuenta 0 USD y ``costo_usd_max`` no lo frena."
        },
        "protocolo": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProtocoloCompatible"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Desde 1.8: API que habla el modelo; obligatorio en suscripciones ``compatible``."
        },
        "region": {
          "anyOf": [
            {
              "maxLength": 40,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Region"
        },
        "seleccionado": {
          "default": false,
          "title": "Seleccionado",
          "type": "boolean"
        },
        "sku": {
          "anyOf": [
            {
              "maxLength": 60,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sku"
        },
        "visto_en": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visto En"
        }
      },
      "required": [
        "modelo",
        "capacidades",
        "origen"
      ],
      "title": "ModeloSuscripcion",
      "type": "object"
    },
    "OidcGithubActions": {
      "additionalProperties": false,
      "description": "Identidad de servicio emitida por el token OIDC de GitHub Actions.",
      "properties": {
        "repositorio": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repositorio",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "workflow": {
          "description": "Claim workflow_ref.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "repositorio",
        "workflow"
      ],
      "title": "OidcGithubActions",
      "type": "object"
    },
    "PrecioModelo": {
      "additionalProperties": false,
      "description": "Desde 1.8: tarifa del modelo en USD por millón de tokens, para los topes de costo.",
      "properties": {
        "cache_lectura": {
          "default": 0.0,
          "minimum": 0,
          "title": "Cache Lectura",
          "type": "number"
        },
        "entrada": {
          "minimum": 0,
          "title": "Entrada",
          "type": "number"
        },
        "salida": {
          "minimum": 0,
          "title": "Salida",
          "type": "number"
        }
      },
      "required": [
        "entrada",
        "salida"
      ],
      "title": "PrecioModelo",
      "type": "object"
    },
    "ProtocoloCompatible": {
      "description": "Desde 1.8: API que habla un modelo de un proveedor ``compatible``.",
      "enum": [
        "anthropic-messages",
        "openai-chat"
      ],
      "title": "ProtocoloCompatible",
      "type": "string"
    },
    "Proveedor": {
      "enum": [
        "foundry",
        "anthropic",
        "compatible"
      ],
      "title": "Proveedor",
      "type": "string"
    },
    "TipoActor": {
      "enum": [
        "humano",
        "servicio",
        "agente"
      ],
      "title": "TipoActor",
      "type": "string"
    }
  },
  "$id": "https://railspec.dev/schemas/v1/suscripcion-modelo.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Conexión de una organización a un proveedor de modelos (desde 1.6).\n\nLa clave **no** forma parte de este contrato: se guarda cifrada aparte y ninguna API la devuelve;\naquí solo consta si hay una (``clave_configurada``). Foundry exige ``endpoint``; Anthropic usa\nel endpoint fijo del proveedor y solo ``api-key``. ``region`` y ``zona_datos`` son los del recurso de\nFoundry: con ellas y el SKU de cada despliegue se deriva la región de cada modelo.",
  "properties": {
    "auditoria": {
      "$ref": "#/$defs/Auditoria"
    },
    "autenticacion": {
      "$ref": "#/$defs/AutenticacionSuscripcion",
      "default": "api-key"
    },
    "clave_actualizada_en": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Clave Actualizada En"
    },
    "clave_configurada": {
      "default": false,
      "title": "Clave Configurada",
      "type": "boolean"
    },
    "endpoint": {
      "anyOf": [
        {
          "maxLength": 512,
          "pattern": "^https://",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Foundry: recurso. ``compatible`` (1.8): base de la API de chat completions de OpenAI.",
      "title": "Endpoint"
    },
    "endpoint_mensajes": {
      "anyOf": [
        {
          "maxLength": 512,
          "pattern": "^https://",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Desde 1.8, solo ``compatible``: base de la API de mensajes de Anthropic.",
      "title": "Endpoint Mensajes"
    },
    "habilitada": {
      "default": true,
      "title": "Habilitada",
      "type": "boolean"
    },
    "id": {
      "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Id",
      "type": "string"
    },
    "modelos": {
      "items": {
        "$ref": "#/$defs/ModeloSuscripcion"
      },
      "title": "Modelos",
      "type": "array"
    },
    "nombre": {
      "maxLength": 120,
      "minLength": 1,
      "title": "Nombre",
      "type": "string"
    },
    "org": {
      "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Org",
      "type": "string"
    },
    "proveedor": {
      "$ref": "#/$defs/Proveedor"
    },
    "proyecto": {
      "anyOf": [
        {
          "maxLength": 512,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Proyecto de Foundry (nombre o URL) para descubrir despliegues.",
      "title": "Proyecto"
    },
    "region": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Region"
    },
    "servicio": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Desde 1.8, solo ``compatible``: servicio conocido (``opencode-zen``, ``minimax``...).",
      "title": "Servicio"
    },
    "ultima_lectura": {
      "anyOf": [
        {
          "$ref": "#/$defs/LecturaSuscripcion"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "version": {
      "description": "Bloqueo optimista; +1 en cada escritura.",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "version_contrato": {
      "default": "1.10",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5",
        "1.6",
        "1.7",
        "1.8",
        "1.9",
        "1.10"
      ],
      "title": "Version Contrato",
      "type": "string"
    },
    "zona_datos": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Zona Datos"
    }
  },
  "required": [
    "version",
    "auditoria",
    "org",
    "id",
    "nombre",
    "proveedor"
  ],
  "title": "SuscripcionModelo",
  "type": "object"
}
