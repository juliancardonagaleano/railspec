{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Quién hizo algo, por qué canal. Va en todo lo que se escribe.\n\nLa identidad estable es el id numérico de GitHub (el login puede cambiar).\nEl proveedor de identidad queda detrás de ``proveedor_identidad`` para que\notro (Azure DevOps, Entra ID) entre como valor nuevo sin romper el esquema.",
      "properties": {
        "agente": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nodo o rol del agente, si tipo=agente.",
          "title": "Agente"
        },
        "canal": {
          "$ref": "#/$defs/Canal"
        },
        "en_nombre_de": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "github_id del humano por quien actúa un agente.",
          "title": "En Nombre De"
        },
        "github_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Id"
        },
        "login": {
          "anyOf": [
            {
              "description": "Login de GitHub; informativo, la identidad es github_id.",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login"
        },
        "oidc": {
          "anyOf": [
            {
              "$ref": "#/$defs/OidcGithubActions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proveedor_identidad": {
          "default": "github",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "title": "Proveedor Identidad",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoActor"
        }
      },
      "required": [
        "tipo",
        "canal"
      ],
      "title": "Actor",
      "type": "object"
    },
    "Auditoria": {
      "additionalProperties": false,
      "properties": {
        "actualizado_en": {
          "format": "date-time",
          "title": "Actualizado En",
          "type": "string"
        },
        "actualizado_por": {
          "$ref": "#/$defs/Actor"
        },
        "creado_en": {
          "format": "date-time",
          "title": "Creado En",
          "type": "string"
        },
        "creado_por": {
          "$ref": "#/$defs/Actor"
        }
      },
      "required": [
        "creado_por",
        "creado_en",
        "actualizado_por",
        "actualizado_en"
      ],
      "title": "Auditoria",
      "type": "object"
    },
    "Canal": {
      "enum": [
        "arnes",
        "consola",
        "ci",
        "servidor"
      ],
      "title": "Canal",
      "type": "string"
    },
    "OidcGithubActions": {
      "additionalProperties": false,
      "description": "Identidad de servicio emitida por el token OIDC de GitHub Actions.",
      "properties": {
        "repositorio": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repositorio",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "workflow": {
          "description": "Claim workflow_ref.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "repositorio",
        "workflow"
      ],
      "title": "OidcGithubActions",
      "type": "object"
    },
    "Rol": {
      "enum": [
        "org-admin",
        "workspace-admin",
        "desarrollador",
        "lector"
      ],
      "title": "Rol",
      "type": "string"
    },
    "SujetoEquipo": {
      "additionalProperties": false,
      "properties": {
        "equipo": {
          "description": "Slug del equipo de GitHub.",
          "maxLength": 100,
          "minLength": 1,
          "title": "Equipo",
          "type": "string"
        },
        "equipo_id": {
          "minimum": 1,
          "title": "Equipo Id",
          "type": "integer"
        },
        "github_org": {
          "maxLength": 39,
          "minLength": 1,
          "title": "Github Org",
          "type": "string"
        },
        "tipo": {
          "const": "equipo",
          "default": "equipo",
          "title": "Tipo",
          "type": "string"
        }
      },
      "required": [
        "github_org",
        "equipo",
        "equipo_id"
      ],
      "title": "SujetoEquipo",
      "type": "object"
    },
    "SujetoUsuario": {
      "additionalProperties": false,
      "properties": {
        "github_id": {
          "minimum": 1,
          "title": "Github Id",
          "type": "integer"
        },
        "tipo": {
          "const": "usuario",
          "default": "usuario",
          "title": "Tipo",
          "type": "string"
        }
      },
      "required": [
        "github_id"
      ],
      "title": "SujetoUsuario",
      "type": "object"
    },
    "TipoActor": {
      "enum": [
        "humano",
        "servicio",
        "agente"
      ],
      "title": "TipoActor",
      "type": "string"
    }
  },
  "$id": "https://railspec.dev/schemas/v1/asignacion-rol.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "auditoria": {
      "$ref": "#/$defs/Auditoria"
    },
    "id": {
      "format": "uuid4",
      "title": "Id",
      "type": "string"
    },
    "org": {
      "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
      "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
      "title": "Org",
      "type": "string"
    },
    "rol": {
      "$ref": "#/$defs/Rol"
    },
    "sujeto": {
      "discriminator": {
        "mapping": {
          "equipo": "#/$defs/SujetoEquipo",
          "usuario": "#/$defs/SujetoUsuario"
        },
        "propertyName": "tipo"
      },
      "oneOf": [
        {
          "$ref": "#/$defs/SujetoUsuario"
        },
        {
          "$ref": "#/$defs/SujetoEquipo"
        }
      ],
      "title": "Sujeto"
    },
    "version": {
      "description": "Bloqueo optimista; +1 en cada escritura.",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "version_contrato": {
      "default": "1.11",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5",
        "1.6",
        "1.7",
        "1.8",
        "1.9",
        "1.10",
        "1.11"
      ],
      "title": "Version Contrato",
      "type": "string"
    },
    "workspace": {
      "anyOf": [
        {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "None = rol a nivel organización.",
      "title": "Workspace"
    }
  },
  "required": [
    "version",
    "auditoria",
    "id",
    "org",
    "rol",
    "sujeto"
  ],
  "title": "AsignacionRol",
  "type": "object"
}
