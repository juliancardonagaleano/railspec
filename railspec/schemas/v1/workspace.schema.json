{
  "$defs": {
    "Actor": {
      "additionalProperties": false,
      "description": "Quién hizo algo, por qué canal. Va en todo lo que se escribe.\n\nLa identidad estable es el id numérico de GitHub (el login puede cambiar).\nEl proveedor de identidad queda detrás de ``proveedor_identidad`` para que\notro (Azure DevOps, Entra ID) entre como valor nuevo sin romper el esquema.",
      "properties": {
        "agente": {
          "anyOf": [
            {
              "maxLength": 120,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Nodo o rol del agente, si tipo=agente.",
          "title": "Agente"
        },
        "canal": {
          "$ref": "#/$defs/Canal"
        },
        "en_nombre_de": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "github_id del humano por quien actúa un agente.",
          "title": "En Nombre De"
        },
        "github_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Github Id"
        },
        "login": {
          "anyOf": [
            {
              "description": "Login de GitHub; informativo, la identidad es github_id.",
              "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Login"
        },
        "oidc": {
          "anyOf": [
            {
              "$ref": "#/$defs/OidcGithubActions"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "proveedor_identidad": {
          "default": "github",
          "pattern": "^[a-z][a-z0-9-]{1,31}$",
          "title": "Proveedor Identidad",
          "type": "string"
        },
        "tipo": {
          "$ref": "#/$defs/TipoActor"
        }
      },
      "required": [
        "tipo",
        "canal"
      ],
      "title": "Actor",
      "type": "object"
    },
    "AlcanceWorkspace": {
      "additionalProperties": false,
      "description": "Espacio de nombres mínimo: todo dato persistido lo lleva.",
      "properties": {
        "org": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Org",
          "type": "string"
        },
        "workspace": {
          "description": "Identificador en minúsculas, dígitos y guiones (máx. 63).",
          "pattern": "^[a-z0-9][a-z0-9-]{0,62}$",
          "title": "Workspace",
          "type": "string"
        }
      },
      "required": [
        "org",
        "workspace"
      ],
      "title": "AlcanceWorkspace",
      "type": "object"
    },
    "Auditoria": {
      "additionalProperties": false,
      "properties": {
        "actualizado_en": {
          "format": "date-time",
          "title": "Actualizado En",
          "type": "string"
        },
        "actualizado_por": {
          "$ref": "#/$defs/Actor"
        },
        "creado_en": {
          "format": "date-time",
          "title": "Creado En",
          "type": "string"
        },
        "creado_por": {
          "$ref": "#/$defs/Actor"
        }
      },
      "required": [
        "creado_por",
        "creado_en",
        "actualizado_por",
        "actualizado_en"
      ],
      "title": "Auditoria",
      "type": "object"
    },
    "Canal": {
      "enum": [
        "arnes",
        "consola",
        "ci",
        "servidor"
      ],
      "title": "Canal",
      "type": "string"
    },
    "OidcGithubActions": {
      "additionalProperties": false,
      "description": "Identidad de servicio emitida por el token OIDC de GitHub Actions.",
      "properties": {
        "repositorio": {
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$",
          "title": "Repositorio",
          "type": "string"
        },
        "run_id": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Run Id"
        },
        "workflow": {
          "description": "Claim workflow_ref.",
          "maxLength": 512,
          "minLength": 1,
          "title": "Workflow",
          "type": "string"
        }
      },
      "required": [
        "repositorio",
        "workflow"
      ],
      "title": "OidcGithubActions",
      "type": "object"
    },
    "Perfil": {
      "enum": [
        "ligero",
        "estandar",
        "profundo"
      ],
      "title": "Perfil",
      "type": "string"
    },
    "TipoActor": {
      "enum": [
        "humano",
        "servicio",
        "agente"
      ],
      "title": "TipoActor",
      "type": "string"
    }
  },
  "$id": "https://railspec.dev/schemas/v1/workspace.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "alcance": {
      "$ref": "#/$defs/AlcanceWorkspace"
    },
    "auditoria": {
      "$ref": "#/$defs/Auditoria"
    },
    "nombre": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Nombre",
      "type": "string"
    },
    "perfil_por_defecto": {
      "$ref": "#/$defs/Perfil",
      "default": "estandar"
    },
    "version": {
      "description": "Bloqueo optimista; +1 en cada escritura.",
      "minimum": 1,
      "title": "Version",
      "type": "integer"
    },
    "version_contrato": {
      "default": "1.7",
      "enum": [
        "1.0",
        "1.1",
        "1.2",
        "1.3",
        "1.4",
        "1.5",
        "1.6",
        "1.7"
      ],
      "title": "Version Contrato",
      "type": "string"
    },
    "zona_datos_azure": {
      "anyOf": [
        {
          "maxLength": 40,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Zona Datos Azure"
    }
  },
  "required": [
    "version",
    "auditoria",
    "alcance",
    "nombre"
  ],
  "title": "Workspace",
  "type": "object"
}
